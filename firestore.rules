rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all for any unapproved collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Main system state document: Allow reading and updating, but strictly forbid deletion to protect system data
    match /system_state/gbfleet_db {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Attachment documents (isolated base64 receipts and files): Allow reading and saving, disallow deletion
    match /system_state/{attachDoc} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}

